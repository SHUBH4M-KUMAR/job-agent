# Copy this to .env and fill in your values

# Ollama model to use for job scoring and cover letter generation
# Run: ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b

# Salary filters (LPA)
MIN_SALARY_LPA=8.0
PREFERRED_SALARY_LPA=12.0
LAST_SALARY_LPA=0.0

# Minimum fit score to auto-apply (0–100)
JOB_FIT_THRESHOLD=65

# Path to Chromium binary (default works on most Linux distros)
# CHROMIUM_BIN=/usr/bin/chromium

# Set to true to run browser in background (no window)
HEADLESS=false

# Milliseconds of delay between browser actions (human-like pacing)
SLOW_MO_MS=120
